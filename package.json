{
  "name": "project-d",
  "version": "0.3.0-dev.0",
  "description": "Project D Windows desktop organizer and ambient desktop shell.",
  "author": "Project D",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ningfangtianwai-pixel/project-d-desktop.git"
  },
  "private": true,
  "os": [
    "win32"
  ],
  "main": "dist/main/bootstrap.js",
  "scripts": {
    "dev": "pnpm build:main && concurrently -k --success first -n vite,electron -c cyan,green \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "pnpm typecheck && vite build && pnpm build:main",
    "build:main": "tsc -p tsconfig.node.json && pnpm build:preload",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.js",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json",
    "lint": "eslint src server scripts tests vite.config.ts vitest.config.ts playwright.config.ts",
    "test": "pnpm build:main && node --test tests/*.test.cjs",
    "test:unit": "pnpm test",
    "test:component": "vitest run --config vitest.config.ts",
    "test:e2e": "pnpm build && pnpm test:e2e:built",
    "test:e2e:built": "playwright test --config playwright.config.ts",
    "test:coverage": "pnpm build:main && node scripts/run-test-coverage.cjs",
    "verify:db": "node scripts/verify-db.cjs",
    "configure:providers": "pnpm build:main && electron scripts/configure-providers.cjs",
    "verify:weather": "node scripts/verify-weather.cjs",
    "verify:assets": "node scripts/verify-asset-ledger.cjs",
    "verify:assets:sync": "node scripts/verify-asset-ledger.cjs sync",
    "verify:assets:report": "node scripts/verify-asset-ledger.cjs report",
    "verify:assets:commercial": "node scripts/verify-asset-ledger.cjs --commercial",
    "verify:supply-chain": "node scripts/generate-supply-chain-evidence.cjs --audit-level high",
    "verify:ai": "pnpm build:main && electron scripts/verify-ai.cjs",
    "qa:soak": "pnpm build && node scripts/qa-soak.cjs --seconds 120",
    "qa:soak:4h": "pnpm build && node scripts/qa-soak.cjs --seconds 14400 --mode stress",
    "qa:soak:24h": "pnpm build && node scripts/qa-soak.cjs --seconds 86400 --mode idle",
    "qa:crash-restart": "pnpm build && node scripts/qa-crash-restart.cjs",
    "qa:release-lifecycle": "node scripts/qa-release-lifecycle.cjs --mode fixture",
    "qa:install-lifecycle": "node scripts/qa-release-lifecycle.cjs --mode fixture",
    "qa:packaged-smoke": "node scripts/qa-packaged-smoke.cjs",
    "qa:clean-desktop-escape": "node scripts/qa-clean-desktop-escape.cjs",
    "qa:user-reported-ui": "node scripts/qa-user-reported-ui.cjs",
    "verify:packaged": "node scripts/verify-packaged-runtime.cjs",
    "verify:package-budget": "node scripts/verify-package-budget.cjs",
    "verify:release-ready": "node scripts/verify-release-readiness.cjs",
    "verify:clean-checkout": "node scripts/verify-clean-checkout.cjs",
    "generate:release-evidence": "node scripts/generate-build-evidence.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "quality": "pnpm lint && pnpm verify:assets && pnpm test:coverage && pnpm test:component && pnpm typecheck && pnpm build && pnpm verify:supply-chain && pnpm qa:release-lifecycle",
    "quality:v4": "pnpm quality && pnpm test:e2e:built",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.5.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.0",
    "lucide-vue-next": "^0.562.0",
    "pixi.js": "^8.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.2.7",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-tsc": "^3.1.8",
    "wait-on": "^9.0.3"
  }
}
